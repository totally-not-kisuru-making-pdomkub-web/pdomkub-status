{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pdomkub-status",
  "compatibility_date": "2026-09-05",
  "main": "src/index.js",
  "assets": {
    "directory": "./app/src/web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "status.kisuru.site/pdomkub",
      "zone_name": "kisuru.site"
    },
    {
      "pattern": "status.kisuru.site/pdomkub/*",
      "zone_name": "kisuru.site"
    }
  ]
}
